# Vorlage für .env – kopieren nach .env und Werte eintragen:
#   cp .env.example .env
# .env wird von docker compose automatisch gelesen und ist in .gitignore/.dockerignore.

# Moodle-Version (Branch, Tag oder Commit)
# MOODLE_REF=MOODLE_503_STABLE

# Öffentliche URL
# MOODLE_WWWROOT=http://localhost

# Eigene Erweiterungen: zusätzliche Compose-Dateien anhängen (Trenner ":" unter Linux/macOS, ";" unter Windows)
# COMPOSE_FILE=docker-compose.yaml:extensions/docker-compose.myplugins.yaml
